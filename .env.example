# Credenciais do projeto Supabase Artefact
# Copie este arquivo para .env e preencha com os valores do dashboard:
# Supabase → Project Settings → API

# URL da API REST (inclua /rest/v1)
SUPABASE_REST_URL=https://SEU_PROJECT_REF.supabase.co/rest/v1

# Chave de API (recomendado: service_role para seed/importação de dados)
# Settings → API → service_role (secret) ou anon (public)
SUPABASE_KEY=sua_chave_aqui

# OpenAI API Key (embeddings + chat)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua_chave_aqui

# Modelo LLM padrão (pode ser alterado no painel Admin → Modelo IA)
LLM_MODEL=gpt-4o

# Origem do frontend (Vercel). Ex.: https://seu-app.vercel.app
# Use * em desenvolvimento local. Pode listar várias separadas por vírgula.
FRONTEND_ORIGIN=*
