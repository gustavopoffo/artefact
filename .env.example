# Credenciais do projeto Supabase Artefact
# Copie este arquivo para .env e preencha com os valores do dashboard:
# Supabase → Project Settings → API

# URL da API REST (inclua /rest/v1)
SUPABASE_REST_URL=https://SEU_PROJECT_REF.supabase.co/rest/v1

# Chave de API (recomendado: service_role para seed/importação de dados)
# Settings → API → service_role (secret) ou anon (public)
SUPABASE_KEY=sua_chave_aqui
